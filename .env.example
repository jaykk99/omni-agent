# Supabase (RLS is disabled, so the anon key has full access — no service-role key needed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIN that gates the whole app
APP_PIN=

# AI gateway ("OmniRoute" — OpenRouter-compatible)
OPENROUTER_API_KEY=
OMNIROUTE_MODEL=anthropic/claude-3.5-sonnet

# Live browser
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
