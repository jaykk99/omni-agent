# Everything here is OPTIONAL. The app boots with zero env vars set and
# degrades gracefully — see "Keyless mode" in the README. Add keys only for
# the features you want to unlock.

# --- Chat history (Supabase) ---
# Without these, chats work but are NOT saved (they live in server memory and
# can reset when the serverless instance recycles). RLS is disabled on the
# tables (see supabase/schema.sql), so the anon key is enough — no
# service-role key needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App gate (PIN) ---
# Optional. When unset, the app opens with no PIN screen at all.
# When set, middleware requires the PIN cookie before any page loads.
APP_PIN=

# --- Model gateway ("OmniRoute" — OpenAI/OpenRouter-compatible) ---
# Without a key, the app answers with a free keyless demo model
# (Pollinations' anonymous tier) and the browser/terminal tools are
# unavailable — the UI says this plainly instead of erroring.
OMNIROUTE_API_KEY=
# Point at a self-hosted OmniRoute/error-inbox pool, or leave unset for
# OpenRouter. UI tier names "fast"/"strong" are auto-mapped to real model
# ids when the gateway is plain OpenRouter.
OMNIROUTE_BASE_URL=
# Default model when the UI sends a tier name or nothing. Accepts tier names
# (fast/strong) for the error-inbox pool, or any real model id.
OMNIROUTE_MODEL=
# Direct OpenRouter alternative to OMNIROUTE_API_KEY (used only if
# OMNIROUTE_API_KEY is unset).
OPENROUTER_API_KEY=

# --- Keyless demo chat (optional overrides) ---
# Without a gateway key the app answers via a free anonymous model
# (Pollinations' legacy tier — best-effort, rate/budget-limited). Point
# these at any OpenAI-compatible endpoint to override it.
# KEYLESS_CHAT_URL=
# KEYLESS_CHAT_MODEL=

# --- Live browser (LEGACY — not needed) ---
# The browser now runs as a Chromium inside the per-chat Vercel Sandbox —
# no Browserbase key required. These are ignored by the app and kept here
# only for anyone reverting to the old path.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# --- Sandbox tuning ---
# How long a chat's sandbox lives (ms). Vercel Sandbox authenticates via the
# project's OIDC token on Vercel — no token needed there.
SANDBOX_TIMEOUT_MS=1800000
