# Supabase (RLS is disabled, so the anon key has full access — no service-role key needed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIN that gates the whole app
APP_PIN=

# AI gateway ("OmniRoute" — OpenAI/OpenRouter-compatible).
# By default this proxies through error-inbox's own multi-provider LLM pool
# (no separate provider key needed here — error-inbox holds those):
OMNIROUTE_BASE_URL=https://error-inbox.vercel.app/api/v1
OMNIROUTE_API_KEY=
# To go directly to OpenRouter instead, set OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
# and OMNIROUTE_API_KEY to an OpenRouter key (or set OPENROUTER_API_KEY).
OMNIROUTE_MODEL=strong

# Live browser
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
