# Supabase (service-role key only — the app has no per-user auth)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PIN that gates the whole app
APP_PIN=

# AI gateway ("OmniRoute" — OpenRouter-compatible)
OPENROUTER_API_KEY=
OMNIROUTE_MODEL=anthropic/claude-3.5-sonnet

# Live browser
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
